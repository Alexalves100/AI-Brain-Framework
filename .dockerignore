# AI-Brain-Framework .dockerignore
# https://docs.docker.com/engine/reference/builder/#dockerignore-file

# Git
.git
.gitignore
.gitattributes

# CI/CD
.github

# Documentation (build context only)
*.md
!framework/**/*.md
!README.md
docs/

# Tests
tests/
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
*.whl

# Virtual environments
.venv
venv
env
ENV/

# IDE
.vscode
.idea
*.swp
*.swo
.DS_Store

# Local config
.env
.env.local
*.local

# Build artifacts
*.log
*.tmp
*.bak

# Framework internal data
.memory.json
.knowledge.json
.audit.jsonl
